<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Required by Termux RunCommandService. The permission is defined by
         Termux as dangerous; the rooted Manager grants it to itself before
         invoking the service so there is no interactive permission dialog. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND"/>
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:node="remove" />

    <!-- Termux documents package visibility as required for RUN_COMMAND clients
         targeting Android 11 / targetSdk 30 or newer. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:name=".X11Application"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.X11Manager"
        tools:replace="android:allowBackup,android:enableOnBackInvokedCallback">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboard|keyboardHidden"
            android:theme="@style/Theme.X11Manager.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Lorie renderer is hosted directly in the Display Compose tab.
             Keep only the broadcast bridge needed by CmdEntryPoint; standalone
             display/preferences/accessibility components are not app surfaces. -->
        <activity
            android:name="com.termux.x11.MainActivity"
            tools:node="remove" />
        <activity
            android:name="com.termux.x11.LoriePreferences"
            tools:node="remove" />
        <service
            android:name="com.termux.x11.utils.KeyInterceptor"
            tools:node="remove" />
        <receiver
            android:name="com.termux.x11.LoriePreferences$Receiver"
            tools:node="remove" />
        <meta-data
            android:name="android.allow_multiple_resumed_activities"
            tools:node="remove" />
    </application>

</manifest>
