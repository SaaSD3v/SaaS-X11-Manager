<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:node="remove" />

    <application
        android:name=".X11Application"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.X11Manager"
        tools:replace="android:allowBackup,android:enableOnBackInvokedCallback,android:extractNativeLibs">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboard|keyboardHidden"
            android:theme="@style/Theme.X11Manager.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".operations.LogOperationService"
            android:exported="false" android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started Linux container installation, verification and graphical runtime control with live progress logs" />
        </service>
        <receiver android:name=".operations.OperationNotificationReceiver" android:exported="false" />

        <!-- The only Android audio host in this experimental branch. PulseAudio
             runs as this app UID in a dedicated process and exits when no Linux
             container remains registered as an audio consumer. -->
        <service
            android:name=".audio.NativeAudioRuntimeService"
            android:exported="false"
            android:stopWithTask="false"
            android:process=":audio"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The Lorie renderer is hosted directly in the Display Compose tab.
             Keep only the broadcast bridge needed by CmdEntryPoint; standalone
             display/preferences/accessibility components are not app surfaces. -->
        <activity
            android:name="com.termux.x11.MainActivity"
            tools:node="remove" />
        <activity
            android:name="com.termux.x11.LoriePreferences"
            tools:node="remove" />
        <service
            android:name="com.termux.x11.utils.KeyInterceptor"
            tools:node="remove" />
        <receiver
            android:name="com.termux.x11.LoriePreferences$Receiver"
            tools:node="remove" />
        <meta-data
            android:name="android.allow_multiple_resumed_activities"
            tools:node="remove" />
    </application>

</manifest>
