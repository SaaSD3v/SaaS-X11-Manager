<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:name=".X11Application"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.X11Manager"
        tools:replace="android:allowBackup">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.X11Manager.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lorie is an embedded renderer/server library in this APK. Its
             standalone UI, settings, accessibility service and exported
             broadcast entry points are not part of the Manager surface. The
             EmbeddedX11View registers its CmdEntryPoint Binder receiver
             dynamically, so none of these manifest components are needed for
             the in-process Screen integration. -->
        <activity
            android:name="com.termux.x11.MainActivity"
            tools:node="remove" />
        <activity
            android:name="com.termux.x11.LoriePreferences"
            tools:node="remove" />
        <service
            android:name="com.termux.x11.utils.KeyInterceptor"
            tools:node="remove" />
        <receiver
            android:name="com.termux.x11.LoriePreferences$Receiver"
            tools:node="remove" />
        <receiver
            android:name="com.termux.x11.LorieBroadcastReceiver"
            tools:node="remove" />
    </application>

</manifest>
